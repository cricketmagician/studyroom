rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isTeacher() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role == 'teacher';
    }

    // materials/{teacherId}/{file}: limits must match MAX_BYTES in src/lib/files.ts
    match /materials/{teacherId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if isTeacher() && request.auth.uid == teacherId && (
        (request.resource.contentType == 'application/pdf' && request.resource.size <= 100 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/.*') && request.resource.size <= 2048 * 1024 * 1024)
      );
      allow delete: if request.auth != null && request.auth.uid == teacherId;
    }
  }
}
