rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'teacher';
    }

    // One profile per user. Users can only ever create themselves as students;
    // make someone a teacher by editing their `role` in the Firebase console.
    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['name', 'email', 'role', 'level', 'createdAt']) &&
        request.resource.data.get('level', 'Intermediate') in ['Foundation', 'Intermediate', 'Final'] &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.get('createdAt', request.time) == request.time &&
        request.resource.data.role == 'student' &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
      allow update, delete: if false;
    }

    // Each user's private saved / done / notes per file. Only they can see or change it.
    match /profiles/{uid}/library/{materialId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['saved', 'done', 'note', 'updatedAt']) &&
        request.resource.data.get('saved', false) is bool &&
        request.resource.data.get('done', false) is bool &&
        request.resource.data.get('note', '') is string &&
        request.resource.data.get('note', '').size() <= 5000 &&
        request.resource.data.updatedAt == request.time;
    }

    // Each user's private notebook.
    match /profiles/{uid}/notes/{noteId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['title', 'body', 'pinned', 'createdAt', 'updatedAt']) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.body is string && request.resource.data.body.size() <= 20000 &&
        request.resource.data.pinned is bool &&
        request.resource.data.updatedAt == request.time;
    }

    // Each user's private to-do list.
    match /profiles/{uid}/tasks/{taskId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['title', 'done', 'due', 'createdAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
        request.resource.data.done is bool &&
        (request.resource.data.due == null || (request.resource.data.due is string && request.resource.data.due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }

    // Each student's private mistake book from mock tests, with a spaced-review schedule.
    match /profiles/{uid}/mistakes/{mistakeId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['paper', 'chapter', 'mock', 'kind', 'question', 'wrong', 'fix', 'marks', 'box', 'due', 'mastered', 'createdAt', 'updatedAt']) &&
        request.resource.data.paper is string && request.resource.data.paper.size() > 0 && request.resource.data.paper.size() <= 4 &&
        request.resource.data.chapter is string && request.resource.data.chapter.size() <= 200 &&
        request.resource.data.mock is string && request.resource.data.mock.size() <= 80 &&
        request.resource.data.kind in ['concept', 'calc', 'silly', 'read', 'formula', 'time'] &&
        request.resource.data.question is string && request.resource.data.question.size() <= 2000 &&
        request.resource.data.wrong is string && request.resource.data.wrong.size() > 0 && request.resource.data.wrong.size() <= 2000 &&
        request.resource.data.fix is string && request.resource.data.fix.size() <= 2000 &&
        request.resource.data.marks is int && request.resource.data.marks >= 0 && request.resource.data.marks <= 100 &&
        request.resource.data.box is int && request.resource.data.box >= 0 && request.resource.data.box <= 5 &&
        request.resource.data.due is string && request.resource.data.due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        request.resource.data.mastered is bool &&
        request.resource.data.updatedAt == request.time;
    }

    // AI study pack per file. Only the server writes its content; the owning teacher reviews,
    // then publishes it (the only field they may change). Students read it once published.
    match /materials/{materialId}/ai/{docId} {
      function ownsFile() {
        return signedIn() && get(/databases/$(database)/documents/materials/$(materialId)).data.teacherId == request.auth.uid;
      }
      allow read: if ownsFile() || (signedIn() && resource != null && resource.data.status == 'ready' && resource.data.published == true);
      allow update: if ownsFile() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published']) &&
        request.resource.data.published is bool;
      allow delete: if ownsFile();
      allow create: if false;
    }
    // AI usage counters (profiles/{uid}/usage/...) have no rule on purpose: only the server can read or write them.

    // Uploaded PDFs and videos. Everyone signed in can read; teachers manage their own.
    match /materials/{id} {
      allow read: if signedIn();
      allow create: if isTeacher() &&
        request.resource.data.keys().hasOnly(['title', 'type', 'url', 'storagePath', 'size', 'teacherId', 'teacherName', 'createdAt', 'subjectId', 'subject', 'level', 'paperCode']) &&
        request.resource.data.teacherId == request.auth.uid &&
        request.resource.data.type in ['pdf', 'video'] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
        request.resource.data.storagePath.matches('materials/' + request.auth.uid + '/.*') &&
        request.resource.data.createdAt == request.time;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow update: if false;
    }
  }
}
