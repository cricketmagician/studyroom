rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'teacher';
    }

    // One profile per user. Users can only ever create themselves as students;
    // make someone a teacher by editing their `role` in the Firebase console.
    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['name', 'email', 'role']) &&
        request.resource.data.role == 'student' &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow update, delete: if false;
    }

    // Uploaded PDFs and videos. Everyone signed in can read; teachers manage their own.
    match /materials/{id} {
      allow read: if signedIn();
      allow create: if isTeacher() &&
        request.resource.data.keys().hasOnly(['title', 'type', 'url', 'storagePath', 'size', 'teacherId', 'teacherName', 'createdAt']) &&
        request.resource.data.teacherId == request.auth.uid &&
        request.resource.data.type in ['pdf', 'video'] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
        request.resource.data.storagePath.matches('materials/' + request.auth.uid + '/.*') &&
        request.resource.data.createdAt == request.time;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow update: if false;
    }
  }
}
