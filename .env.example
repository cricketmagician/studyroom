# Firebase project settings: Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# In-app Google sign-in (One Tap + FedCM button). Google Cloud console > APIs & Services > Credentials > "Web client (auto created by Google Service)" > Client ID.
# Add your site (and http://localhost:3001 for testing) under its Authorized JavaScript origins. Leave empty to use the popup.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# AI study help (server only - never prefix with NEXT_PUBLIC_). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Firebase Admin credentials for the AI routes (not needed with `npm run local`).
# Vercel: paste the whole service-account JSON (Firebase console > Project settings > Service accounts) as one line.
FIREBASE_SERVICE_ACCOUNT=
# Local alternative: path to the downloaded Firebase Admin JSON file (keep it out of Git).
GOOGLE_APPLICATION_CREDENTIALS=
